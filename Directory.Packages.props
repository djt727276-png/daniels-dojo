<Project>

  <!--
    Central NuGet package management. Only packages actually consumed by Phase 1
    are declared here. Versions are pinned to the .NET 10 servicing line and the
    stable test toolchain. Confirm exact patch versions against your restore feed;
    they are intentionally aligned to the .NET 10 shared framework.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- API: development-only OpenAPI document generation (.NET 10 built-in). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Transitive pin (CentralPackageTransitivePinningEnabled). Microsoft.AspNetCore.OpenApi
      still resolves Microsoft.OpenApi 2.0.0, which carries GHSA-v5pm-xwqc-g5wc (high).
      2.7.5 is the first patched release. Remove this pin once the framework package
      references a patched version itself.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup Label="Persistence (Phase 2)">
    <!-- EF Core 10 SQL Server provider. Infrastructure-only; never referenced by
         Domain or Application. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!-- Design-time only: migrations and scaffolding. Consumed with PrivateAssets. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Readiness probe support for the DbContext. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Authentication (Phase 3)">
    <!-- Entra External ID bearer validation. Brings the Microsoft.IdentityModel stack with it. -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
  </ItemGroup>

  <ItemGroup Label="Database test toolchain (Phase 2)">
    <!-- Real SQL Server for schema/constraint tests. No SQLite or InMemory provider. -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <!-- Between-test reset that preserves infrastructure.__EFMigrationsHistory. -->
    <PackageVersion Include="Respawn" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test toolchain">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Integration tests boot the real host via WebApplicationFactory. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>

</Project>

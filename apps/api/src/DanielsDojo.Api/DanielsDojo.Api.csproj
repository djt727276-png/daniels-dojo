<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Globalization must stay enabled: Microsoft.Data.SqlClient throws
      "Globalization Invariant Mode is not supported" at startup, so the Phase 1
      InvariantGlobalization setting is incompatible with SQL Server persistence. The
      runtime base image (mcr.microsoft.com/dotnet/aspnet:10.0, Debian) ships ICU, so the
      container build is unaffected.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>daniels-dojo-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Development-only OpenAPI document generation (.NET 10 built-in generator). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Entra External ID bearer token validation. -->
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DanielsDojo.Application\DanielsDojo.Application.csproj" />
    <ProjectReference Include="..\DanielsDojo.Infrastructure\DanielsDojo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configuration validator is internal by design; its rules are security-relevant
         enough to test directly rather than only through a booted host. -->
    <InternalsVisibleTo Include="DanielsDojo.IntegrationTests" />
  </ItemGroup>

</Project>

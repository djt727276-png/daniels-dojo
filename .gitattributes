# Normalize line endings: author with LF in the repository.
* text=auto eol=lf

# Scripts that must retain their platform line endings
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh  text eol=lf

# Common source and config files
*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.ts      text
*.js      text
*.json    text
*.html    text
*.scss    text
*.css     text
*.md      text
*.yml     text
*.yaml    text
Dockerfile text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
